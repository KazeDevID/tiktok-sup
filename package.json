{
  "name": "@kazedevid/tiktok-sup",
  "version": "1.5.0",
  "description": "Pure TikTok scraper & downloader for Node.js without third-party APIs. Scrape videos (clean MP4 no-watermark), photo carousels, audio MP3, creator profile & video feed, hashtags, sound feeds, engagement analytics, captions/transcripts, and comments directly from tiktok.com.",
  "main": "index.js",
  "types": "index.d.ts",
